[Unit]
Description=Grades Student Portal
After=network.target

[Service]
Type=simple
User=portal
Group=portal
WorkingDirectory=/opt/portal
Environment="PORTAL_STATIC_DIR=/opt/portal/static"
Environment="PORTAL_DB_PATH=/opt/portal/grades-portal.db"
Environment="PORTAL_JWT_SECRET_FILE=/opt/portal/.jwt-secret"
Environment="PORTAL_TEACHER_TOKEN_FILE=/opt/portal/.teacher-token"
Environment="PORTAL_ADDR=:8080"
Environment="PORTAL_COOKIE_SECURE=true"
Environment="PORTAL_COOKIE_DOMAIN=mrpopovici.com"
Environment="PORTAL_RATE_LIMIT=300"
Environment="PORTAL_MATERIALS_DIR=/opt/portal/materials"
Environment="PORTAL_SUBMISSIONS_DIR=/opt/portal/submissions"
Environment="PORTAL_JPLAG_JAR=/opt/portal/lib/jplag.jar"
# Optional: seeds a shared read-only demo student account (username "demo").
# Share the password privately; remove the line and restart to delete the account.
#Environment="PORTAL_DEMO_PASSWORD=choose-a-strong-password"
ExecStart=/opt/portal/portal
Restart=on-failure
RestartSec=5
MemoryMax=1536M

[Install]
WantedBy=multi-user.target
